# Keeps the build context small and fast, and makes sure nothing
# environment-specific or secret from a developer's machine ends up baked
# into the image.

.venv/
__pycache__/
*.pyc
*.pyo

.env
.env.*
!.env.example

# Runtime data — mounted as volumes (see docker-compose.yml), never baked
# into the image. See Dockerfile's comment on why.
models/
uploads/
storage/

.pytest_cache/
.mypy_cache/
.ruff_cache/
htmlcov/
.coverage

.git/
.gitignore

*.md
