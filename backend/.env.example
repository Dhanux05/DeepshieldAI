# Copy this file to .env and fill in real values. Never commit the real .env.

# ---------- Application ----------
DEBUG=true
LOG_LEVEL=INFO

# ---------- Database ----------
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/deepshieldai
SQL_ECHO=false

# ---------- Security ----------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=CHANGE_ME_GENERATE_A_REAL_SECRET
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ---------- CORS ----------
CORS_ORIGINS=http://localhost:5173

# ---------- Storage ----------
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=100

# ---------- ML ----------
MODEL_DIR=models
INFERENCE_DEVICE=cpu
